# Garfeed — variáveis de ambiente. Copie para `.env` na raiz (nunca commitar o .env).
# Os valores abaixo funcionam com infra/docker-compose.dev.yml.

# --- Geral ---
NODE_ENV=development
# Nível de log do pino: trace | debug | info | warn | error
LOG_LEVEL=info

# --- API ---
API_PORT=3000
# Origens liberadas no CORS (painel e cardápio), separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Domínio dos cookies (guestToken e refresh). Vazio em dev; ".garfeed.com.br" em produção
COOKIE_DOMAIN=

# --- Auth (painel) ---
# Segredos: gere com `openssl rand -hex 32` (mínimo 32 caracteres). Use valores diferentes.
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-com-32-caracteres
# Assina o guestToken do cliente anônimo (cookie httpOnly, 6 h)
GUEST_TOKEN_SECRET=troque-este-segredo-do-cliente-com-32-caracteres
# Validade do refresh token (cookie httpOnly, rotacionado a cada uso) em dias
REFRESH_TOKEN_DAYS=30

# --- PostgreSQL 16 ---
POSTGRES_USER=garfeed
POSTGRES_PASSWORD=garfeed
POSTGRES_DB=garfeed
DATABASE_URL=postgresql://garfeed:garfeed@localhost:5434/garfeed?schema=public

# --- Redis 7 (cache, rate limit, BullMQ, adapter do Socket.io) ---
REDIS_URL=redis://localhost:6380

# --- MinIO (S3 self-hosted) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=garfeed
MINIO_ROOT_PASSWORD=garfeed-minio-dev
MINIO_BUCKET=garfeed-media
# URL pública de onde a mídia é servida (Nginx com cache na frente do MinIO em produção)
MEDIA_PUBLIC_URL=http://localhost:9000/garfeed-media

# --- Web Push (VAPID) — gere com `npx web-push generate-vapid-keys` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@garfeed.com.br

# --- URLs públicas ---
# Base da URL gravada nas placas (CSV de lotes): ${TAG_BASE_URL}/GF7K2P
TAG_BASE_URL=https://g.garfeed.com.br

# --- Seed (pnpm --filter api seed) ---
# Senha de TODOS os usuários do seed (dono, gerente, garçom, cozinha, superadmin)
SEED_PASSWORD=garfeed123
