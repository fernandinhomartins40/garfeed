# Garfeed — variáveis de ambiente. Copie para `.env` na raiz (nunca commitar o .env).
# Os valores abaixo funcionam com infra/docker-compose.dev.yml.
# PRODUÇÃO (infra/docker-compose.yml): troque o que está marcado com [prod]. O compose já define sozinho
# NODE_ENV, API_PORT, DATABASE_URL, REDIS_URL e MINIO_ENDPOINT/PORT/USE_SSL (rede interna), então esses podem ficar como estão.

# --- Geral ---
NODE_ENV=development
# Nível de log do pino: trace | debug | info | warn | error
LOG_LEVEL=info

# --- API ---
API_PORT=3000
# Origens liberadas no CORS (painel e cardápio), separadas por vírgula
# [prod] https://painel.garfeed.com.br,https://g.garfeed.com.br
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Domínio dos cookies (guestToken e refresh). Vazio em dev. [prod] .garfeed.com.br
COOKIE_DOMAIN=

# --- Auth (painel) ---
# [prod] Segredos: gere com `openssl rand -hex 32` (mínimo 32 caracteres). Use valores diferentes.
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-com-32-caracteres
# Assina o guestToken do cliente anônimo (cookie httpOnly, 6 h)
GUEST_TOKEN_SECRET=troque-este-segredo-do-cliente-com-32-caracteres
# Validade do refresh token (cookie httpOnly, rotacionado a cada uso) em dias
REFRESH_TOKEN_DAYS=30
# Rate limit (Redis) das rotas /public: requisições por minuto por IP. Todos os celulares no Wi-Fi do
# restaurante saem pelo mesmo IP; pedido/chamado/eventos têm ainda limite próprio por sessão da mesa.
PUBLIC_RATE_LIMIT_PER_MIN=600

# --- PostgreSQL 16 ---  [prod] troque POSTGRES_PASSWORD (ex.: openssl rand -hex 24; sem @ : / na senha)
POSTGRES_USER=garfeed
POSTGRES_PASSWORD=garfeed
POSTGRES_DB=garfeed
DATABASE_URL=postgresql://garfeed:garfeed@localhost:5434/garfeed?schema=public

# --- Redis 7 (cache, rate limit, BullMQ, adapter do Socket.io) ---
REDIS_URL=redis://localhost:6380

# --- MinIO (S3 self-hosted) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=garfeed
# [prod] troque (mínimo 8 caracteres)
MINIO_ROOT_PASSWORD=garfeed-minio-dev
MINIO_BUCKET=garfeed-media
# URL pública da mídia = {origem}/{bucket} (path-style). O painel também faz o upload (PUT pré-assinado) nessa origem.
# A API e o worker usam as mesmas variáveis MINIO_* / MEDIA_PUBLIC_URL / DATABASE_URL / REDIS_URL.
# [prod] https://midia.garfeed.com.br/garfeed-media
MEDIA_PUBLIC_URL=http://localhost:9000/garfeed-media

# --- Web Push (VAPID) — [prod] gere com `pnpm --filter api exec web-push generate-vapid-keys` ---
# Vazio = push desligado (o painel continua recebendo por Socket.io). A chave pública é servida em GET /push/vapid-public-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@garfeed.com.br

# --- Push nativo do app iOS (APNs direto, sem Firebase) — [prod] ver docs/apps-nativos/COMPILAR-SEM-MAC.md ---
# Faltando qualquer uma das quatro primeiras = push do iPhone desligado (o resto funciona normalmente).
# Key ID (10 caracteres) da chave APNs criada em developer.apple.com > Keys
APNS_KEY_ID=
# Team ID da conta Apple Developer (10 caracteres)
APNS_TEAM_ID=
# Conteúdo do AuthKey_XXXX.p8 em base64, numa linha só: `base64 -w0 AuthKey_XXXX.p8`
APNS_KEY_P8=
# Bundle id do app iOS
APNS_BUNDLE_ID=br.com.garfeed.painel
# true = servidor de produção da Apple (TestFlight e App Store). false só para build de desenvolvimento feito no Xcode.
APNS_PRODUCTION=true

# --- URLs públicas ---
# Base da URL gravada nas placas (CSV de lotes): ${TAG_BASE_URL}/GF7K2P
TAG_BASE_URL=https://g.garfeed.com.br

# --- Seed (pnpm --filter api seed) ---
# Senha de TODOS os usuários do seed (dono, gerente, garçom, cozinha, superadmin)
SEED_PASSWORD=garfeed123

# --- Front-ends (Vite: apps/painel e apps/cardapio) ---
# Entram no bundle no BUILD (o infra/docker-compose.yml as passa como build args). Vão para o navegador: nunca segredos.
# Em dev local os padrões já servem; para mudar, crie apps/painel/.env.local ou apps/cardapio/.env.local com elas.
# (O Vite não lê este .env da raiz: o NODE_ENV=development daqui viraria build de dev do React.)
# URL da API (REST + Socket.io). Vazio = http://localhost:3000 em dev. [prod] https://api.garfeed.com.br
VITE_API_URL=http://localhost:3000
# Base da URL gravada nas placas (QR de emergência impresso pelo painel)
VITE_TAG_BASE_URL=https://g.garfeed.com.br
# Chave pública VAPID do painel (mesma de VAPID_PUBLIC_KEY). Vazia = o painel busca em GET /push/vapid-public-key.
VITE_VAPID_PUBLIC_KEY=

# --- Produção: domínio, certificado e backup (infra/docker-compose.yml) ---
# Domínio raiz: o nginx atende DOMAIN, www., g., painel., api. e midia. (um certificado Let's Encrypt para todos)
DOMAIN=garfeed.com.br
# E-mail do Let's Encrypt (avisos de expiração) — usado no comando de emissão do README
LETSENCRYPT_EMAIL=contato@garfeed.com.br
# Pasta do host com os backups (relativa a infra/): pg/*.dump (14 dias) + minio/<bucket> (espelho)
BACKUP_DIR=./backups
# Horário do backup em cron, UTC (06:00 UTC = 03:00 em Brasília)
BACKUP_CRON="0 6 * * *"
BACKUP_RETENTION_DAYS=14
# Cópia fora da VPS (opcional, recomendado): qualquer S3 compatível (outro MinIO, Backblaze B2, Wasabi...). Vazio = só local.
BACKUP_REMOTE_URL=
BACKUP_REMOTE_ACCESS_KEY=
BACKUP_REMOTE_SECRET_KEY=
BACKUP_REMOTE_BUCKET=garfeed-backup
