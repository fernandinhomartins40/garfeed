# Produção (HTTPS). O entrypoint do nginx troca ${DOMAIN} (padrão garfeed.com.br) e grava em /etc/nginx/conf.d.
# Um certificado só (SAN) para os 6 nomes: ver README, "Certificado".
include /etc/nginx/snippets/http.conf;

ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

# HTTP: desafio do Let's Encrypt (renovação) e redireciono para HTTPS
server {
  listen 80;
  server_name ${DOMAIN} www.${DOMAIN} g.${DOMAIN} painel.${DOMAIN} api.${DOMAIN} midia.${DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server { listen 443 ssl; http2 on; server_name ${DOMAIN};        include /etc/nginx/snippets/landing.conf; }
server { listen 443 ssl; http2 on; server_name www.${DOMAIN};    return 301 https://${DOMAIN}$request_uri; }
server { listen 443 ssl; http2 on; server_name g.${DOMAIN};      include /etc/nginx/snippets/cardapio.conf; }
server { listen 443 ssl; http2 on; server_name painel.${DOMAIN}; include /etc/nginx/snippets/painel.conf; }
server { listen 443 ssl; http2 on; server_name api.${DOMAIN};    include /etc/nginx/snippets/api.conf; }
server { listen 443 ssl; http2 on; server_name midia.${DOMAIN};  include /etc/nginx/snippets/midia.conf; }
