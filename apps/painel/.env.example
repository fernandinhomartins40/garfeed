# Painel (Vite) — copie para apps/painel/.env.local
# URL da API (REST + Socket.io)
VITE_API_URL=http://localhost:3000
# Base da URL gravada nas placas (QR de emergência)
VITE_TAG_BASE_URL=https://g.garfeed.com.br
# Chave pública VAPID (mesma de VAPID_PUBLIC_KEY da API). Vazia = sem Web Push, só notificação local.
VITE_VAPID_PUBLIC_KEY=
