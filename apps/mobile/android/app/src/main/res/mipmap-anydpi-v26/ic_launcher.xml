<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone adaptativo: fundo marinho da marca (#142433), símbolo laranja (ic_maskable já traz o fundo marinho)
     e versão monocromática para os ícones temáticos do Android 13+ (símbolo branco, só o alfa conta). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/backgroundColor" />
    <foreground>
        <inset android:drawable="@mipmap/ic_maskable" android:inset="8.5dp" />
    </foreground>
    <monochrome>
        <inset android:drawable="@drawable/ic_notification_icon" android:inset="28%" />
    </monochrome>
</adaptive-icon>
