{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts prisma/seed.ts --format esm --target node20 --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma": "dotenv -e ../../.env -- prisma",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.0.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "prisma": "^6.19.0",
    "socket.io": "^4.8.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@garfeed/shared": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^8.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "vitest": "^4.0.0"
  }
}
